{
  "name": "rails-typespec-openapi-first-sample",
  "version": "1.0.0",
  "private": true,
  "description": "TypeSpec API contract for a minimal Rails task application",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "openapi": "tsp compile api/main.tsp && npm run openapi:docs",
    "openapi:check": "ruby bin/check-openapi",
    "openapi:docs": "redocly build-docs openapi/openapi.yaml --output public/api-docs.html --disableGoogleFont --theme.openapi.hideDownloadButton=true --title \"Tasks API\""
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.61.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0"
  }
}
