{
  "name": "rails-typespec-openapi-first-sample",
  "version": "1.0.0",
  "private": true,
  "description": "TypeSpec API contract for a minimal Rails task application",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "openapi": "tsp compile api/main.tsp && npm run openapi:ui",
    "openapi:check": "ruby bin/check-openapi",
    "openapi:ui": "ruby bin/build-api-ui"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "scarfSettings": {
    "enabled": false
  },
  "allowScripts": {
    "@scarf/scarf": false
  },
  "devDependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "swagger-ui-dist": "5.33.1"
  }
}
